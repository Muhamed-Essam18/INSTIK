generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Stage {
  HEAR_IT
  FOLLOW_IT
  UNDERSTAND_IT
  JOIN_IN
}

enum Understood {
  MOSTLY
  SOME
  NOT_YET
}

// Auth.js models (standard adapter shape). There is deliberately no password column.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  // Honest hours: the learner's IANA time zone (days are placed in it), and two personal settings.
  timeZone      String?
  remindersOn   Boolean   @default(false)
  hourSound     Boolean   @default(false)

  accounts         Account[]
  sessions         Session[]
  languages        LearnerLanguage[]
  answers          ComprehensionAnswer[]
  watchSessions    WatchSession[]
  manualTimes      ManualTime[]
  videoProgress    VideoProgress[]
  // Billing: the Stripe customer for this learner (set when they first start checkout) and their subscription.
  stripeCustomerId String?               @unique
  subscription     Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One profile per learner per language. minutesPerDay is one of 10, 20, 30, 60 (checked in code).
model LearnerLanguage {
  id              String    @id @default(cuid())
  userId          String
  languageCode    String
  stage           Stage
  minutesPerDay   Int
  // Honest hours: end of the last accepted counted interval, and the budget for late (queued) intervals.
  countedUntil    DateTime?
  lateWindowStart DateTime?
  lateSeconds     Int       @default(0)
  // Highest whole hour already announced with the chime; never decreases.
  chimedHours     Int       @default(0)
  // Goal-sized blocks already acknowledged with Done for today on `doneDay`.
  doneDay         DateTime? @db.Date
  doneBlocks      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  preference Preference?

  @@unique([userId, languageCode])
  @@index([userId])
}

// Transcript layer toggles for one language profile. A missing row means "defaults".
model Preference {
  id                String   @id @default(cuid())
  learnerLanguageId String   @unique
  layers            Json
  updatedAt         DateTime @updatedAt

  learnerLanguage LearnerLanguage @relation(fields: [learnerLanguageId], references: [id], onDelete: Cascade)
}

// The current "Did you follow this one?" answer for one video. No score, no history.
model ComprehensionAnswer {
  id           String     @id @default(cuid())
  userId       String
  languageCode String
  videoSlug    String
  answer       Understood
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode, videoSlug])
  @@index([userId, languageCode])
}

// Bookkeeping for the sign-in link and waitlist send limits (keyed by a salted hash); holds no learner content.
model SignInAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Counted watching for one learner, language and video on one local day. Heartbeats add to `seconds`.
model WatchSession {
  id           String   @id @default(cuid())
  userId       String
  languageCode String
  videoSlug    String
  day          DateTime @db.Date
  seconds      Int
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode, videoSlug, day])
  @@index([userId, languageCode, day])
}

// Time the learner says they spent outside Instik. Always shown as "Added by you". minutes is 1 to 600 (checked in code).
model ManualTime {
  id           String   @id @default(cuid())
  userId       String
  languageCode String
  day          DateTime @db.Date
  minutes      Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, languageCode, day])
}

// Where the learner is in one video. Drives "pick up where you left off" and the Watched label.
model VideoProgress {
  id              String   @id @default(cuid())
  userId          String
  languageCode    String
  videoSlug       String
  positionSeconds Int
  watched         Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode, videoSlug])
  @@index([userId, languageCode, updatedAt])
}

// One visitor's request to hear about one language. The email is trimmed and lower-cased before saving.
model WaitlistEntry {
  id           String   @id @default(cuid())
  languageCode String
  email        String
  createdAt    DateTime @default(now())

  @@unique([languageCode, email])
  @@index([languageCode])
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum BillingPlan {
  MONTHLY
  YEARLY
}

enum StripeEventOutcome {
  RECEIVED
  PROCESSED
  IGNORED
  UNMATCHED
}

// A learner's paid access. Mirrors their current Stripe subscription and holds no card data. One row per learner;
// a learner who subscribes again after an ended subscription has this row replaced. It is the only basis for access decisions.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  plan                 BillingPlan
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean
  // When Stripe created that subscription; decides whether a different subscription may replace an ended row.
  stripeCreatedAt      DateTime
  // When the Stripe read that produced this row started; a later write is applied only if its read started no earlier.
  syncedAt             DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One webhook delivery, kept for idempotency and for reviewing unmatched events. Mirrors Stripe; holds no learner content or card data.
model StripeEvent {
  id             String             @id
  type           String
  outcome        StripeEventOutcome
  stripeObjectId String?
  receivedAt     DateTime           @default(now())
  processedAt    DateTime?

  @@index([outcome, receivedAt])
}
