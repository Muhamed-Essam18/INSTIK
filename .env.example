# Copy to .env.local and fill in. Never commit real values.

# Neon pooled connection string (used by the app). Use sslmode=verify-full (not require) so the pg driver does not warn.
DATABASE_URL=
# Neon direct (non-pooled) connection string (used by `prisma migrate`).
DIRECT_URL=
# Signs and encrypts sessions. At least 32 characters; generate with `npx auth secret`.
AUTH_SECRET=
# Base URL of the site. Optional locally; set in production (Vercel provides the host).
AUTH_URL=
# Google OAuth client (Google Cloud console).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend API key, used to send sign-in links.
AUTH_RESEND_KEY=
# Sender of sign-in emails; must be on a verified Resend domain.
EMAIL_FROM=
# Random string (at least 16 characters) used to hash visitor addresses for the send limit.
IP_HASH_SALT=
# Public address of the site, used for share links, the sitemap and robots.txt. Optional; falls back to the Vercel production URL, then localhost.
SITE_URL=

# Billing (all optional; billing stays off until prices are set in src/lib/billing/plans.ts and these are present).
# Stripe test-mode secret key (starts sk_test_). A live key (sk_live_) is refused unless BILLING_LIVE=true.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (from `stripe listen` locally, or the dashboard endpoint).
STRIPE_WEBHOOK_SECRET=
# Leave unset until launch. Must be "true" to accept a live Stripe key.
BILLING_LIVE=
# Id of the Mux signing key used to sign playback tokens for full-access videos.
MUX_SIGNING_KEY_ID=
# That signing key's private key, base64-encoded PEM. Server only.
MUX_SIGNING_PRIVATE_KEY=

# Creator uploads (all optional; set the three Mux values together or none). Mux access token (Video read and write) and the webhook signing secret.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Vercel Blob read/write token (Storage > Blob), used for host photos.
BLOB_READ_WRITE_TOKEN=

# Creator programme: comma-separated emails of the Instik team; they get the owner role. Leave empty for none.
OWNER_EMAILS=
